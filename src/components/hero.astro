---
---
<!-- src/components/hero.astro -->
<div id="inicio" class="relative h-screen w-full overflow-hidden bg-zinc-900">
    <!-- Imagen de fondo: capa más baja (z-0) -->
    <img
        src="/Foto_escritorio.jpg"
        alt="Fondo escritorio"
        class="absolute inset-0 w-full h-full object-cover z-0"
    />

    <!-- Texto principal: queda entre fondo y figura recortada (z-10) -->
    <h1
        class="absolute inset-x-0 top-1/2 transform -translate-y-1/2 z-10 text-white font-family-hanson text-6xl md:text-[10rem] tracking-widest text-center whitespace-nowrap hero-text"
        aria-label="NACHO ROMÁ"
    >
        NACHO ROMÁ
    </h1>

    <!-- Imagen recortada: capa superior que tapa el texto (z-20) -->
    <img
        src="/Foto_escritorio_sinFondo.png"
        alt="Nacho Romá"
        class="absolute inset-0 w-full h-full object-cover z-20 pointer-events-none"
        aria-hidden="true"
    />
</div>

<style>
    /* Sombra pronunciada y animación de entrada para el texto */
    .hero-text {
        /* Proyección de sombra para dar volumen sobre el fondo */
        text-shadow: 0px 15px 30px rgba(0, 0, 0, 0.65);

        /* Estado inicial: invisible y ligeramente mayor (para hacer zoom-out) */
        opacity: 0;
        transform: scale(1.05);

        /* Animación de entrada: 1.5s, easing suave, mantiene estado final */
        animation: fadeScale 1.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes fadeScale {
        0% {
            opacity: 0;
            transform: scale(1.05);
        }
        100% {
            opacity: 1;
            transform: scale(1);
        }
    }

    /* Opcional: asegurar que el texto no pierda nitidez en tamaños muy grandes */
    .hero-text {
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }

    /* Ajuste responsivo fino (opcional): evita overflow en pantallas pequeñas */
    @media (max-width: 640px) {
        .hero-text {
            font-size: 3rem; /* fallback si Tailwind no aplica en este contexto */
            white-space: normal;
            padding: 0 1rem;
        }
    }
</style>
