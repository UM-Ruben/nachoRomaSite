<section id="contacto" class="min-h-screen bg-zinc-900 text-white px-6 py-24">
  <div class="mx-auto max-w-4xl">
    <span class="text-sm uppercase tracking-[0.4em] text-zinc-400">Contacto</span>
    <h2 class="mt-6 text-5xl font-bold">¿Quieres que Nacho vaya a tu ciudad?</h2>
    <p class="mt-6 text-lg text-zinc-300">Escribe a <a href="mailto:booking@nachoroma.com" class="text-white underline">booking@nachoroma.com</a> y te contamos cómo organizar la fiesta.</p>
    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      <div class="rounded-3xl border border-white/10 bg-white/5 p-8">
        <h3 class="text-xl font-semibold">Booking</h3>
        <p class="mt-4 text-zinc-300">Cartel, rider técnico y rutas disponibles.</p>
      </div>
      <div class="rounded-3xl border border-white/10 bg-white/5 p-8">
        <h3 class="text-xl font-semibold">Promoción</h3>
        <p class="mt-4 text-zinc-300">Contacta para ideas de contenido, shows y fechas especiales.</p>
      </div>
    </div>
  </div>
</section>
